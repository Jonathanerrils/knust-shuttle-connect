rules_version = '2';

// KNUST Shuttle Connect — Firestore security rules.
// Drivers never read student check-ins; destination demand is exposed only as
// aggregate counters maintained by trusted Cloud Functions on stop documents.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole('admin'));
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /stops/{stopId} {
      allow read: if signedIn();
      allow create, delete: if hasRole('admin');
      allow update: if hasRole('admin')
        || (hasRole('driver')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['enRouteBy', 'enRouteAt', 'arrivedAt']));
    }

    match /checkins/{uid} {
      function validActiveCheckIn() {
        return request.resource.data.keys().hasOnly([
                 'journeyId',
                 'stopId', 'stopName',
                 'destinationStopId', 'destinationStopName',
                 'createdAt', 'updatedAt', 'expiresAt',
                 'missedBoardingCount', 'lastMissedBoardingAt'
               ])
          && request.resource.data.journeyId is string
          && request.resource.data.journeyId.size() >= 12
          && request.resource.data.stopId is string
          && request.resource.data.destinationStopId is string
          && request.resource.data.stopId != request.resource.data.destinationStopId
          && request.resource.data.missedBoardingCount is int
          && request.resource.data.missedBoardingCount >= 0
          && exists(/databases/$(database)/documents/stops/$(request.resource.data.stopId))
          && exists(/databases/$(database)/documents/stops/$(request.resource.data.destinationStopId))
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt.toMillis()
               <= request.time.toMillis() + 30 * 60 * 1000;
      }

      function validTerminalUpdate() {
        return !resource.data.keys().hasAny(['endReason', 'endedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['endReason', 'endedAt', 'updatedAt'])
          && request.resource.data.endedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            request.resource.data.endReason == 'boarded'
            || request.resource.data.endReason == 'cancelled'
            || request.resource.data.endReason == 'geofenceExited'
          );
      }

      function validMissedBoardingUpdate() {
        return !resource.data.keys().hasAny(['endReason', 'endedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'missedBoardingCount',
                   'lastMissedBoardingAt',
                   'updatedAt'
                 ])
          && request.resource.data.missedBoardingCount
               == resource.data.missedBoardingCount + 1
          && request.resource.data.lastMissedBoardingAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      allow read: if signedIn() && (request.auth.uid == uid || hasRole('admin'));
      allow create: if signedIn()
        && request.auth.uid == uid
        && validActiveCheckIn()
        && request.resource.data.missedBoardingCount == 0;
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          validTerminalUpdate()
          || validMissedBoardingUpdate()
          || (validActiveCheckIn()
              && request.time > resource.data.updatedAt + duration.value(55, 's'))
        );
      // Completed/expired records are deleted only by trusted server code after
      // the terminal outcome has been written to the immutable event stream.
      allow delete: if false;
    }

    match /shuttles/{driverUid} {
      allow read: if signedIn();
      allow write: if hasRole('driver') && request.auth.uid == driverUid;
    }

    // Network reference data is readable in-app but only administrators may
    // mutate it. These collections support expansion beyond one campus.
    match /routes/{routeId} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }

    match /operators/{operatorId} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }

    match /networks/{networkId} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }

    match /trips/{tripId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    match /analytics_daily/{docId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // Immutable raw event stream. Only trusted server code writes it. Keeping
    // client writes disabled prevents forged analytics and protects the future
    // BigQuery export from untrusted instrumentation.
    match /analytics_events/{eventId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }
  }
}
